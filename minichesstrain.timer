[Unit]
Description=Mini Chess AI Training Timer (00:00 UTC daily start)
# Do NOT use Requires - let the timer live independently of the service

[Timer]
# Fire every day at 00:00 UTC
# The script itself waits until 02:00 UTC to start training and exits at 10:00 UTC
OnCalendar=*-*-* 00:00:00

# If a run was missed (server powered off), do not run it on next boot
Persistent=false

# Trigger accuracy
AccuracySec=1min

[Install]
WantedBy=timers.target
